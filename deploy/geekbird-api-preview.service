[Unit]
Description=GeekBird isolated preview API
After=network.target

[Service]
Type=simple
User=geekbird-preview
Group=geekbird-preview
WorkingDirectory=/opt/geekbird-api/current
EnvironmentFile=/etc/geekbird-preview/api.env
ExecStart=/opt/geekbird-api/current/venv/bin/uvicorn api.app:create_app --factory --host 127.0.0.1 --port 8767 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
StateDirectory=geekbird-preview
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/geekbird-preview

[Install]
WantedBy=multi-user.target
